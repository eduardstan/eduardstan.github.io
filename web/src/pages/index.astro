---
import BaseLayout from '../layouts/BaseLayout.astro';
import Record from '../components/Record.astro';
import SectionHead from '../components/SectionHead.astro';
import { about, bibliography, profile, SOURCES } from '../lib/record';
import { cv, CV_SOURCE, isEditorial, serviceGroups, serviceWhen } from '../lib/cv';
import { inline } from '../lib/inline';
import { announcements, formatStamp } from '../lib/announcements';
import { strands } from '../lib/strands';

const { name, affiliation } = profile();
const bio = about();
const bib = bibliography();
const feed = announcements();
const research = strands();

/**
 * Service, read from `cv/cv.yaml` — the file the printed CV is generated from —
 * through the grouping `/professional_activities/` uses.
 *
 * It used to be read from `_pages/professional_activities.md`, a hand-written
 * third copy of the same list, while that page read the YAML. The two pages
 * therefore stated the same facts from two sources and disagreed on four of
 * them. There is now one source for both.
 */
const groups = serviceGroups();
const editorials = groups.filter((group) => isEditorial(group.role)).flatMap((group) => group.entries);

const counts = [
  { n: bib.entries.length, label: 'entries in this bibliography' },
  ...bib.byKind.map((kind) => ({ n: kind.count, label: `${kind.kind.toLowerCase()} entries` })),
  { n: editorials.length, label: 'editorial boards' },
  { n: cv.service.length, label: 'service roles on record' },
];

/**
 * How many announcements the front page carries. Six is what balances the third
 * column against the lead at 1440 without the page turning into a scroll; the
 * whole feed lives at /news/. One edit here retunes it.
 */
const LATELY = 6;
const shown = feed.items.slice(0, LATELY);
const withheld = feed.items.length - shown.length;
---

<BaseLayout
  title={name}
  description={`${affiliation[0]}, ${affiliation.at(-1)}. Interpretable AI, temporal and logic methods, agentic AI.`}
>
  <section class="masthead">
    <h1>{name}</h1>
    {
      /* The dateline states the size of the record, so both figures are counted
         at build rather than typed. */
    }
    <div class="dateline label">
      {affiliation.map((line) => <span>{line}</span>)}
      <span class="em">
        {bib.entries.length} publications · {editorials.length} editorial boards
      </span>
    </div>
  </section>

  <div class="sheet">
    <div class="col lead">
      {
        /* The person, above the fold and inside the grid: a photograph and one
           sentence in his own voice, both taken from the repository rather than
           written for the occasion. */
      }
      <figure class="person">
        <img
          src="/img/portrait.jpg"
          width="500"
          height="500"
          alt={`${name}, photographed against a plain background`}
        />
        <div>
          <blockquote>{bio.firstPerson}</blockquote>
          <figcaption class="label">{name} · {affiliation[0]}</figcaption>
          <Record>
            <p>Quoted verbatim from <b>{bio.firstPersonSource}</b>.</p>
          </Record>
        </div>
      </figure>

      <SectionHead source={SOURCES.about}>The work</SectionHead>
      {bio.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
      <Record>
        <p>
          <b>{SOURCES.about}</b>, section <code>## about</code>, {bio.lineRange} — {
            bio.paragraphs.length
          } paragraphs, rendered verbatim.
        </p>
      </Record>

      <SectionHead source="web/src/lib/strands.ts">Three strands</SectionHead>
      <ol class="strands">
        {
          research.map((strand) => (
            <li>
              <h3>{strand.title}</h3>
              <p>{strand.body}</p>
            </li>
          ))
        }
      </ol>
      <Record>
        <p>
          Unlike everything else on this page, the strands are not read out of a repository file —
          nothing in the repository states a strand structure. The copy lives in <b
            >web/src/lib/strands.ts</b
          >, and each strand names the files its claim rests on.
        </p>
        {
          research.map((strand) => (
            <p>
              <b>{strand.title}</b> — {strand.evidence.join(', ')}
              {strand.absent.length > 0 && (
                <>
                  {' · '}not present on this branch: {strand.absent.join(', ')}, so this strand has
                  no evidence in the repository as it stands
                </>
              )}
            </p>
          ))
        }
      </Record>
    </div>

    <div class="col">
      <SectionHead source={SOURCES.bibliography}>The count</SectionHead>
      <ul class="stats">
        {
          counts.map((count) => (
            <li>
              <span class="n">{count.n}</span>
              <span class="l label">{count.label}</span>
            </li>
          ))
        }
      </ul>
      <Record>
        <p>
          <b>{SOURCES.bibliography}</b> — {bib.entries.length} entries, {bib.years.first}–{
            bib.years.last
          }, counted at build by parsing the file. The two service figures are counted from <b
            >{CV_SOURCE}</b
          >: <b>{editorials.length}</b> entries of <b>service[]</b> whose <b>role</b> matches
          “editor” ({editorials.map((entry) => entry.venue).join(', ')}), and <b>
            {cv.service.length}
          </b> entries in that list altogether.
        </p>
      </Record>

      {
        groups.map((group, index) => (
          <>
            <SectionHead
              source={`${CV_SOURCE} · service[] · role: ${group.role}`}
              id={index === 0 ? 'service' : undefined}
            >
              {group.role}
            </SectionHead>
            <ul class="defs">
              {group.entries.map((entry) => (
                <li>
                  <span class="a">
                    {entry.url ? (
                      <a href={entry.url} set:html={inline(entry.venue)} />
                    ) : (
                      <Fragment set:html={inline(entry.venue)} />
                    )}
                    {entry.metric &&
                      (entry.rank_url ? (
                        <a class="rank" href={entry.rank_url} set:html={inline(entry.metric)} />
                      ) : (
                        <span class="rank" set:html={inline(entry.metric)} />
                      ))}
                  </span>
                  {serviceWhen(entry) && (
                    <span class="b label" set:html={inline(serviceWhen(entry))} />
                  )}
                </li>
              ))}
            </ul>
          </>
        ))
      }
      <Record>
        <p>
          <b>{CV_SOURCE}</b> — <b>service[]</b>, {cv.service.length} entries grouped into {
            groups.length
          } roles by their own <b>role</b> field ({
            groups.map((group) => `${group.role}: ${group.entries.length}`).join(', ')
          }), in the order those roles first appear in the file. The meta on each row is the entry's{' '}
          <b>dates</b> where it states a term and its <b>years[]</b> where it states editions; the
          badges are the <b>metric</b> field, linked to the <b>rank_url</b> beside it.
        </p>
        <p>
          This column and <a href="/professional_activities/">/professional_activities/</a> read the
          same list through the same grouping in <b>web/src/lib/cv.ts</b>, so they cannot disagree.
          Until this build they did: this column came from <b>_pages/professional_activities.md</b>, a
          hand-written third copy of the same facts that had drifted from the file the CV is generated
          from. Nothing on this site reads it any more.
        </p>
      </Record>
    </div>

    <div class="col">
      <SectionHead source={SOURCES.cv}>Lately</SectionHead>
      <ul class="feed">
        {
          shown.map((item) => (
            <li>
              <span class="when label">
                <time datetime={item.stamp}>{formatStamp(item)}</time>
                {' · '}
                {item.kind}
              </span>
              <p set:html={item.html} />
            </li>
          ))
        }
      </ul>
      <p class="more-feed">
        <a class="label" href="/news/">All {feed.items.length} items →</a>
      </p>
      <Record>
        <p>
          {feed.items.length} announcements, generated from the facts themselves — {
            feed.sources.map((file, index) => (
              <>
                {index > 0 && ', '}
                <b>{file}</b>
              </>
            ))
          }. Nothing is written twice: a fact is announced on the date it carries, and the feed shows
          that date at the precision the source states it and no finer.
        </p>
        <p>
          This column is capped at {LATELY}, so {shown.length} of {feed.items.length} are shown here
          and {withheld} {withheld === 1 ? 'is' : 'are'} not; the full feed is at{' '}
          <a href="/news/">/news/</a>.
        </p>
      </Record>
    </div>
  </div>
</BaseLayout>
