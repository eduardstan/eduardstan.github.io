---
/**
 * The curriculum vitae, rendered from `content/cv.yaml` — the same file the
 * LaTeX CV is generated from, read directly rather than through the PDF.
 *
 * Nothing on this page is transcribed. Every row is one entry of one section in
 * that file, and every source record below is derived from the object it
 * describes: the counts, the field names and the totals are computed here at
 * build time, so a change to the YAML changes the record with it.
 *
 * What the page leaves out is derived the same way, from the file's own sections
 * minus the ones rendered here, so the omission list cannot drift.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Record from '../components/Record.astro';
import SectionHead from '../components/SectionHead.astro';
import Entries from '../components/Entries.astro';
import { cv, CV_SOURCE, entriesOf, keysOf, noteOf, sections } from '../lib/cv';
import { hasSource } from '../lib/record';
import { inline } from '../lib/inline';

/**
 * The printed CV, built from `cv/cv.tex` by the deploy workflow and dropped
 * into `public/` just before `astro build`. It is never committed — no binary
 * enters git history — so it is absent from a plain local build and the offer
 * to download it is made only when the file is really there.
 */
const CV_PDF = 'web/public/assets/cv.pdf';
const pdf = hasSource(CV_PDF);

const appointments = entriesOf(cv.appointments);
const education = entriesOf(cv.education);
const teaching = entriesOf(cv.teaching);
const supervision = entriesOf(cv.supervision);
const awards = entriesOf(cv.awards);
const languages = entriesOf(cv.languages);
const leadership = entriesOf(cv.leadership);

/** Every `rows:` table under a teaching post — the courses themselves. */
const courses = teaching.flatMap((block) => block.rows ?? []);
/** Sum of the leading number in each `hours:` column ("30 h/yr" → 30). */
const hoursOf = (blocks: typeof teaching) =>
  blocks.reduce(
    (total, block) =>
      total + (block.rows ?? []).reduce((sum, row) => sum + parseInt(row['Hours'] ?? '0', 10), 0),
    0,
  );
/** A post whose `dates` still run to Present; the rest are roles that ended. */
const running = teaching.filter((block) => /present\s*$/i.test(block.dates ?? ''));
const contactHours = hoursOf(teaching);
const runningHours = hoursOf(running);
const withItems = (rows: { items?: string[] }[]) => rows.filter((row) => row.items?.length).length;

/** Sections this page renders; every other one is named in a record below. */
const rendered = [
  'appointments',
  'education',
  'teaching',
  'supervision',
  'awards',
  'languages',
  'leadership',
];
const omitted = sections()
  .map(([key]) => key)
  .filter((key) => !rendered.includes(key));

const description =
  `Curriculum vitae — ${appointments.length} appointments, ${education.length} degrees, ` +
  `${courses.length} courses and ${awards.length} awards, read from ${CV_SOURCE} at build time.`;
---

<BaseLayout title="Curriculum vitae" description={description}>
  <PageHead title="Curriculum vitae">
    <p class="blurb" set:html={inline(cv.profile.focus)} />
    <p class="blurb">
      This page is built from <b>{CV_SOURCE}</b>, the single file the printed CV is also generated
      from, read when the page was built. Turn <b>inspect sources</b> on, in the bar above, to see which
      part of that file each section comes from. Publications are not repeated here: they have <a
        href="/publications/">their own index</a
      >, read from the bibliography.
    </p>
    {
      pdf && (
        <p class="blurb">
          <a href="/assets/cv.pdf">Download the printed CV (PDF)</a> — typeset from {CV_SOURCE} by{' '}
          <b>cv/cv.tex</b> when this page was built, so it states the same facts.
        </p>
      )
    }
  </PageHead>

  <SectionHead source={`${CV_SOURCE} · profile.bio.short`}>Short bio</SectionHead>
  <p class="blurb" set:html={inline(cv.profile.bio?.short)} />
  <Record>
    <p>
      <b>{CV_SOURCE}</b> — the <b>profile.bio.short</b> and <b>profile.focus</b> scalars, rendered
      with the file's own inline grammar (<b>**bold**</b>, <b>_italic_</b>, <b>[text](url)</b>). The
      same two strings are what <b>scripts/build-cv-data.mjs</b> turns into LaTeX for the PDF.
    </p>
  </Record>

  <SectionHead source={`${CV_SOURCE} · appointments[]`}>Appointments</SectionHead>
  <Entries entries={appointments} />
  <Record>
    <p>
      <b>{CV_SOURCE}</b> — <b>appointments[]</b>, {appointments.length} entries in file order, newest
      first as written. Keys read: {keysOf(appointments)}. {withItems(appointments)} of {
        appointments.length
      } carry an <b>items</b> list, shown as the bullets under the organisation.
    </p>
  </Record>

  <SectionHead source={`${CV_SOURCE} · education[]`}>Education</SectionHead>
  <Entries entries={education} />
  <Record>
    <p>
      <b>{CV_SOURCE}</b> — <b>education[]</b>, {education.length} entries. Keys read: {
        keysOf(education)
      }. The classification in each degree line (<i>cum laude</i>, 110/110) is part of the <b
        >title</b
      > string in the file, not added here.
    </p>
  </Record>

  <SectionHead source={`${CV_SOURCE} · teaching[]`}>Teaching</SectionHead>
  {
    teaching.map((block) => (
      <>
        <ul class="defs">
          <li>
            <span class="a">
              {block.url ? (
                <a href={block.url} set:html={inline(block.org)} />
              ) : (
                <Fragment set:html={inline(block.org)} />
              )}
            </span>
            <span class="b label">
              <Fragment set:html={inline(block.title)} /> ·{' '}
              <Fragment set:html={inline(block.place)} /> ·{' '}
              <Fragment set:html={inline(block.dates)} />
            </span>
          </li>
        </ul>
        <ul class="rows">
          {(block.rows ?? []).map((row) => (
            <li>
              <span class="k">
                <Fragment set:html={inline(row['Course'])} />
                <span class="sub" set:html={inline(row['Programme / Level'])} />
              </span>
              <span class="v" set:html={inline(row['Key topics'])} />
              <span class="when" set:html={inline(row['Hours'])} />
            </li>
          ))}
        </ul>
      </>
    ))
  }
  <Record>
    <p>
      <b>{CV_SOURCE}</b> — <b>teaching[]</b>, {teaching.length} entries holding {courses.length}
      {' '}courses between them in their <b>rows[]</b> tables. Each heading line is that entry's <b
        >org</b
      >, <b>title</b>, <b>place</b> and <b>dates</b>; each row below it is one row of its <b>rows[]</b
      >, with keys {keysOf(courses)} — and those keys, in the order the file writes them, are also
      the columns of the same table in the printed CV.
    </p>
    <p>
      {teaching.map((block) => `${block.org}: ${(block.rows ?? []).length}`).join(', ')} courses. {
        runningHours
      } contact hours a year currently, across the {running.length} post{
        running.length === 1 ? '' : 's'
      } whose <b>dates</b> run to Present; {contactHours} h/yr summed across all {teaching.length}
      {' '}posts on record, the ended ones included ({
        courses.map((row) => row['Hours']).join(' + ')
      }). Both totals are computed here from the leading number of each <b>hours</b> column; neither
      is a figure written in the file.
    </p>
  </Record>

  <SectionHead source={`${CV_SOURCE} · supervision`}>Supervision</SectionHead>
  {noteOf(cv.supervision).map((paragraph) => <p class="blurb" set:html={inline(paragraph)} />)}
  <Entries entries={supervision} />
  <Record>
    <p>
      <b>{CV_SOURCE}</b> — <b>supervision</b>, written as a map: the <b>note</b> paragraphs above,
      then <b>entries[]</b>, {supervision.length} rows with keys {keysOf(supervision)}. The counts in
      the right-hand column are the <b>count</b> field verbatim, open-ended ({
        supervision.map((row) => row.count).join(', ')
      }) exactly as the file writes them.
    </p>
  </Record>

  <SectionHead source={`${CV_SOURCE} · awards[]`}>Awards and scholarships</SectionHead>
  <Entries entries={awards} />
  <Record>
    <p>
      <b>{CV_SOURCE}</b> — <b>awards[]</b>, {awards.length} entries with keys {keysOf(awards)}.{' '}
      {withItems(awards)} carry an <b>items</b> list.
    </p>
  </Record>

  <SectionHead source={`${CV_SOURCE} · leadership[]`}>Leadership and representation</SectionHead>
  <Entries entries={leadership} />
  <Record>
    <p>
      <b>{CV_SOURCE}</b> — <b>leadership[]</b>, {leadership.length} entries with keys{' '}
      {keysOf(leadership)}. It is an ordinary section of the file that <b>cv/cv.tex</b> does not
      print, which is the whole answer to keeping a section off the PDF and on the site: leave its{' '}
      <code>\cvpart</code> line out.
    </p>
    <p>
      These sections exist in <b>{CV_SOURCE}</b> and this page does not render them: {
        omitted.join(', ')
      }. The list is derived from the file's own top-level sections minus the ones rendered above.
      Both have pages of their own, read from this same file: <b>service</b> at <a
        href="/professional_activities/">/professional_activities/</a
      > and <b>projects</b> at <a href="/projects/">/projects/</a>.
    </p>
  </Record>

  <SectionHead source={`${CV_SOURCE} · languages[]`}>Languages</SectionHead>
  <ul class="defs">
    {
      languages.map((language) => (
        <li>
          <span class="a" set:html={inline(language.title)} />
          <span class="b label" set:html={inline(language.detail)} />
        </li>
      ))
    }
  </ul>
  <Record>
    <p>
      <b>{CV_SOURCE}</b> — <b>languages[]</b>, {languages.length} entries with keys {
        keysOf(languages)
      }, in file order. The levels are the file's own words ({
        [...new Set(languages.map((language) => language.detail))].join(', ')
      }), not a CEFR scale.
    </p>
  </Record>
</BaseLayout>
