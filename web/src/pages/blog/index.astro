---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFormat = new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' });
---

<BaseLayout title="Blog" description="Posts by Eduard I. Stan.">
  <h1 class="text-2xl font-semibold">Blog</h1>
  <ul class="mt-6 space-y-6">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="font-medium hover:text-[var(--color-accent)]">
            {post.data.title}
          </a>
          <p class="text-sm text-[var(--color-muted)]">
            <time datetime={post.data.date.toISOString()}>{dateFormat.format(post.data.date)}</time>
          </p>
          <p class="mt-1 text-sm">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
