---
import PageHead from '../../components/PageHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dateFormat, getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="Posts by Eduard I. Stan.">
  <PageHead title="Blog" />
  <ul class="single mt-6 space-y-6">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="font-medium hover:text-accent">
            {post.data.title}
          </a>
          <p class="text-sm text-muted">
            <time datetime={post.data.date.toISOString()}>{dateFormat.format(post.data.date)}</time>
          </p>
          <p class="mt-1 text-sm">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
