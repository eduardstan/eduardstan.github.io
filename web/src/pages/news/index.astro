---
/**
 * The whole feed. The home page shows only the newest few and links here, so
 * this route is the one that must be complete — every announcement the
 * repository generates, plus the facts it could not date.
 *
 * There is no `_news/` directory behind this any more: every item is derived
 * from the fact it announces. See `src/lib/announcements.ts` for why.
 */
import PageHead from '../../components/PageHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Record from '../../components/Record.astro';
import { announcements, formatStamp } from '../../lib/announcements';

const feed = announcements();
---

<BaseLayout title="News" description={`All ${feed.items.length} announcements and updates.`}>
  <PageHead title="News" />
  <p class="blurb">
    All <b>{feed.items.length} items</b>, newest first, generated when this page was built from the
    facts they announce rather than from a second set of files written by hand.
    {
      feed.undated.length > 0 && (
        <>
          {' '}
          {feed.undated.length} further fact{feed.undated.length === 1 ? '' : 's'} could be announced
          but carr{feed.undated.length === 1 ? 'ies' : 'y'} no defensible date; turn{' '}
          <b>inspect sources</b> on to see which.
        </>
      )
    }
  </p>
  <ul class="feed single mt-6">
    {
      feed.items.map((item) => (
        <li>
          <span class="when label">
            <time datetime={item.stamp}>{formatStamp(item)}</time>
            {' · '}
            {item.kind}
          </span>
          <p set:html={item.html} />
        </li>
      ))
    }
  </ul>
  <Record>
    <p>
      {feed.items.length} announcements, read at build from {
        feed.sources.map((file, index) => (
          <>
            {index > 0 && ', '}
            <b>{file}</b>
          </>
        ))
      }. A fact is announced on the date it carries; an <code>announced</code> key is written onto a
      fact only where the announcement happened on a date the fact does not otherwise state. Dates
      are shown at the precision the source states and no finer, so an item shown as a year is one
      whose source records only a year.
    </p>
    {
      feed.undated.map((fact) => (
        <p>
          <b>{fact.source}</b> — “{fact.what}” is not announced: {fact.why}.
        </p>
      ))
    }
  </Record>
</BaseLayout>
