---
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../lib/record';

const links = [
  { href: '/publications/', label: 'index' },
  { href: '/news/', label: 'news' },
  { href: '/professional_activities/', label: 'service' },
  { href: '/projects/', label: 'projects' },
  { href: '/talks/', label: 'talks' },
  { href: '/blog/', label: 'blog' },
  { href: '/cv/', label: 'cv' },
  { href: '/search/', label: 'search' },
];

// Astro's default `trailingSlash: 'ignore'` means the same page can be reached
// with or without a slash, so normalise before comparing. The comparison is a
// prefix, not an equality: /publications/type/ is still the index, and a blog
// post is still the blog.
const normalise = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const current = normalise(Astro.url.pathname);
const isCurrent = (href: string) => current.startsWith(normalise(href));
const { name } = profile();
---

<header class="bar" data-pagefind-ignore>
  <a class="label who" href="/">{name} / Milano-Bicocca</a>
  <nav aria-label="Main" class="label">
    {
      links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  {
    /* The label for the inspect checkbox in BaseLayout. Its visible text is its
       whole accessible name, and the checkbox announces its own on/off state, so
       the switch graphic beside it is decoration only. */
  }
  <label class="label chip inspect-switch" for="inspect">Inspect sources</label>
  <ThemeToggle />
</header>
