---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/blog/', label: 'blog' },
  { href: '/publications/', label: 'publications' },
  { href: '/projects/', label: 'projects' },
  { href: '/news/', label: 'news' },
  { href: '/professional_activities/', label: 'activities' },
  { href: '/repositories/', label: 'repositories' },
  { href: '/cv/', label: 'cv' },
  { href: '/search/', label: 'search' },
];

// Astro's default `trailingSlash: 'ignore'` means the same page can be reached
// with or without a slash, so normalise before comparing.
const normalise = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const current = normalise(Astro.url.pathname);
---

<header class="border-b border-[var(--color-rule)]" data-pagefind-ignore>
  <div class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-4">
    <a href="/" class="font-semibold">Eduard I. Stan</a>
    <nav aria-label="Main" class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={current === normalise(link.href) ? 'page' : undefined}
            class="text-[var(--color-muted)] hover:text-[var(--color-accent)] aria-[current=page]:text-[var(--color-ink)] aria-[current=page]:underline"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="ms-auto"><ThemeToggle /></div>
  </div>
</header>
