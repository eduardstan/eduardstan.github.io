---
const year = new Date().getFullYear();
---

<footer
  class="mt-16 border-t border-[var(--color-rule)] text-sm text-[var(--color-muted)]"
  data-pagefind-ignore
>
  <div class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-4 gap-y-1 px-4 py-6">
    <span>&copy; {year} Eduard I. Stan</span>
    <a href="/rss.xml" class="hover:text-[var(--color-accent)]">RSS</a>
    <a href="/sitemap-index.xml" class="hover:text-[var(--color-accent)]">Sitemap</a>
  </div>
</footer>
