---
import Record from './Record.astro';
import { profile, SOURCES } from '../lib/record';

const { name, email, links, missing, address, addressSource } = profile();
const year = new Date().getFullYear();
---

<footer class="sheet-footer" data-pagefind-ignore>
  <div class="footer-grid">
    <div>
      <h2 class="label">Contact</h2>
      {email && <a href={`mailto:${email}`}>{email}</a>}
      <Record>
        <p><b>{SOURCES.cv}</b> — <code>profile.email</code> and <code>profile.name</code>.</p>
      </Record>
    </div>
    <div>
      <h2 class="label">Elsewhere</h2>
      <div class="stack">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href="/rss.xml">RSS</a>
        <a href="/sitemap-index.xml">Sitemap</a>
      </div>
      <Record>
        <p>
          <b>{SOURCES.cv}</b> — one link per <code>profile.links</code> account that carries an ID.
          The address is built from the ID here and in <b>scripts/build-cv-data.mjs</b>, so no
          address is written twice.
          {
            missing.length > 0 && (
              <>
                {' '}
                No ID in the file, so not shown: {missing.map((kind) => <code>{kind}</code>)}.
              </>
            )
          }
        </p>
      </Record>
    </div>
    <div>
      <h2 class="label">Post</h2>
      <address>{address.map((line) => <>{line}<br /></>)}</address>
      <Record>
        <p>
          <b>{addressSource}</b> — <code>affiliation[]</code> broadest first, then{' '}
          <code>address[]</code> and <code>place</code>.
        </p>
      </Record>
    </div>
  </div>
  <p class="label colophon">
    &copy; {year} {name} &middot; Built with <a href="https://github.com/eduardstan/ledgerpress"
      >ledgerpress</a
    >
  </p>
</footer>
